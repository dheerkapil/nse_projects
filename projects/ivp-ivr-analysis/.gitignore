# Project-specific: the SQLite DB is NOT tracked.
# It is rebuilt from data/daily/*.json by scripts/bootstrap_db.py at the start
# of every run, so committing it only wrote ~13 MB into git history on every
# run — which is how this repo reached 257 MB.
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# Output files (except JSON, and the daily Excel report)
*.csv
*.xlsx
!output/*.xlsx

# Local config
config/local_*.json

# nse-ops: the per-day workbook is a Telegram deliverable, not a record.
# data/daily/<date>.json is the record, so the ~670 KB xlsx stays out of git.
# This line comes last on purpose: within one .gitignore the last match wins,
# which overrides the "!output/*.xlsx" negation above.
output/*.xlsx
